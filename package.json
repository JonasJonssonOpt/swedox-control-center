{
  "name": "swedox-control-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "supabase:version": "supabase --version",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "owner:bootstrap:local": "node scripts/bootstrap-control-center-owner.mjs --confirm-owner-bootstrap",
    "owner:verify:local": "node scripts/bootstrap-control-center-owner.mjs --confirm-owner-bootstrap --verify",
    "runtime:test:installations:seed-pagination": "node scripts/runtime-tests/create-installation-pagination-fixtures.mjs",
    "runtime:test:installations:cleanup-pagination": "node scripts/runtime-tests/cleanup-installation-pagination-fixtures.mjs",
    "supabase:reset": "supabase db reset --local",
    "supabase:lint": "supabase db lint --local --schema public --fail-on error",
    "supabase:test": "supabase test db supabase/tests/database --local",
    "supabase:types": "supabase gen types typescript --local --schema public | prettier --parser typescript > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}

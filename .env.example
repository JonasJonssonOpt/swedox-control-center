# Public project URL from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable key. A legacy anon key can be used during migration.
# This key is not a secret; access must be restricted by server checks and RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase Auth UUID for the single Control Center owner.
CONTROL_CENTER_OWNER_USER_ID=
